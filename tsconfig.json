{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vscode"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/unit/**/*.ts", "tests/integration/**/*.ts", "scripts/**/*.ts", "vitest.config.mts"],
  "exclude": ["tests/fixtures", "node_modules", "dist", "out"]
}
